{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"E:/WindowsWorkspace/omnicompany/venv/Scripts/python.exe\" -m omnicompany.dashboard.ccdaemon.hooks.todos --provider codex",
            "timeout": 30
          }
        ],
        "matcher": "apply_patch|Edit|Write"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"E:/WindowsWorkspace/omnicompany/venv/Scripts/python.exe\" -m omnicompany.dashboard.ccdaemon.hooks.trace --provider codex",
            "timeout": 30
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"E:/WindowsWorkspace/omnicompany/venv/Scripts/python.exe\" -m omnicompany.dashboard.ccdaemon.hooks.trace --provider codex",
            "timeout": 30
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"E:/WindowsWorkspace/omnicompany/venv/Scripts/python.exe\" -m omnicompany.dashboard.ccdaemon.hooks.lock_pretooluse --provider codex",
            "timeout": 30,
            "statusMessage": "Checking Omnicompany write policy"
          }
        ],
        "matcher": "Bash|apply_patch|Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"E:/WindowsWorkspace/omnicompany/venv/Scripts/python.exe\" -m omnicompany.dashboard.ccdaemon.hooks.session_start --provider codex",
            "timeout": 30,
            "statusMessage": "Loading Omnicompany session context"
          }
        ],
        "matcher": "startup|resume|clear|compact"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"E:/WindowsWorkspace/omnicompany/venv/Scripts/python.exe\" -m omnicompany.dashboard.ccdaemon.hooks.trace --provider codex",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"E:/WindowsWorkspace/omnicompany/venv/Scripts/python.exe\" -m omnicompany.dashboard.ccdaemon.hooks.user_prompt_submit --provider codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
