{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Semantic-first AI work assessment",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "summary": {"type": "string"},
    "evaluation_state": {
      "type": "string",
      "enum": ["provisional", "unknown", "inconclusive"]
    },
    "correctness_gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"type": "string", "enum": ["met", "not_met", "mixed", "unknown"]},
        "reason": {"type": "string"},
        "evidence_refs": {"type": "array", "maxItems": 16, "items": {"type": "string"}}
      },
      "required": ["status", "reason", "evidence_refs"]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["comparable", "partially_comparable", "not_comparable", "unknown"]
        },
        "matched_task_class": {"type": "string"},
        "scale_handling": {"type": "string"},
        "confounders": {"type": "array", "maxItems": 12, "items": {"type": "string"}}
      },
      "required": ["status", "matched_task_class", "scale_handling", "confounders"]
    },
    "dimensions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/dimension_assessment"}
    },
    "facts": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/finding"}
    },
    "inferences": {
      "type": "array",
      "maxItems": 8,
      "items": {"$ref": "#/$defs/inference"}
    },
    "unknowns": {"type": "array", "maxItems": 16, "items": {"type": "string"}},
    "next_observations": {
      "type": "array",
      "maxItems": 12,
      "items": {"$ref": "#/$defs/next_observation"}
    }
  },
  "required": [
    "summary",
    "evaluation_state",
    "correctness_gate",
    "comparison",
    "dimensions",
    "facts",
    "inferences",
    "unknowns",
    "next_observations"
  ],
  "$defs": {
    "dimension_assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "type": "string",
          "enum": ["time", "token_cost", "user_expectation", "objective_outcome", "human_attention"]
        },
        "status": {
          "type": "string",
          "enum": ["better", "worse", "stable", "mixed", "unknown", "not_comparable"]
        },
        "reason": {"type": "string"},
        "measurement_scope": {"type": "string"},
        "evidence_refs": {"type": "array", "maxItems": 16, "items": {"type": "string"}}
      },
      "required": ["dimension", "status", "reason", "measurement_scope", "evidence_refs"]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim": {"type": "string"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}}
      },
      "required": ["claim", "evidence_refs"]
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claim": {"type": "string"},
        "confidence": {"type": "string", "enum": ["low", "medium", "high"]},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string"}},
        "disconfirming_evidence": {"type": "string"}
      },
      "required": ["claim", "confidence", "evidence_refs", "disconfirming_evidence"]
    },
    "next_observation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "question": {"type": "string"},
        "why": {"type": "string"},
        "existing_source_candidates": {"type": "array", "maxItems": 8, "items": {"type": "string"}}
      },
      "required": ["question", "why", "existing_source_candidates"]
    }
  }
}
