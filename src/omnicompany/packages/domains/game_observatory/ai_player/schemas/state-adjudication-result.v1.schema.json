        "type": "string"
      },
      "title": "Assignment Version Ids",
      "type": "array"
    },
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "packet_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Packet Sha256",
      "type": "string"
    },
    "persistence_reopen_verified": {
      "title": "Persistence Reopen Verified",
      "type": "boolean"
    },
    "replay_seed_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
