    "fixture_sha256",
    "provider",
    "requested_model_selector",
    "external_session_id",
    "requested_case_count",
    "requested_case_ids",
    "completed_case_count",
    "full_image_diagnostic_set",
    "formal_disqualifiers",
    "diagnostic_quality_pass",
    "diagnostic_failures",
    "expected_recall",
    "important_recall",
    "precision",
    "evidence_complete_rate",
    "safety_violation_count",
    "unmatched_proposal_count",
    "unmatched_proposal_rate",
    "same_native_session",
    "cases",
    "turns",
    "raw_runtime_root",
    "status",
    "started_at",
    "completed_at"
