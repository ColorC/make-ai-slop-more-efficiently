    "fixture_path": {
      "title": "Fixture Path",
      "type": "string"
    },
    "fixture_semantic_status": {
      "const": "candidate",
      "default": "candidate",
      "title": "Fixture Semantic Status",
      "type": "string"
    },
    "fixture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixture Sha256",
      "type": "string"
    },
    "formal_disqualifiers": {
