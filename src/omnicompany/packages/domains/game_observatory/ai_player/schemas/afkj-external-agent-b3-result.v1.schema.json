        "unexpected_tool_events": {
          "minimum": 0,
          "title": "Unexpected Tool Events",
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/ExternalAgentTokenUsageV1"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        }
      },
      "required": [
        "invocation_id",
        "operation",
        "status",
        "external_session_id",
        "resolved_model_id",
        "model_evidence",
        "actual_effort",
        "effort_evidence",
        "duration_seconds",
        "provider_duration_seconds",
        "time_to_first_token_seconds",
        "provider_cost_usd",
        "usage",
        "unexpected_tool_events",
        "warning_count",
        "event_log_path",
        "event_log_sha256",
        "last_message_path",
        "last_message_sha256"
