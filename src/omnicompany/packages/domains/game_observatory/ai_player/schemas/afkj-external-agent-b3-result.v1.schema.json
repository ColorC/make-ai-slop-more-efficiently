    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/AFKJB3CaseResultV1"
      },
      "title": "Cases",
      "type": "array"
    },
    "completed_at": {
      "title": "Completed At",
      "type": "string"
    },
    "completed_case_count": {
      "maximum": 10,
      "minimum": 0,
      "title": "Completed Case Count",
      "type": "integer"
    },
    "continuity_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Continuity Manifest Sha256",
      "type": "string"
    },
    "decision_p50_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision P50 Seconds"
    },
    "decision_p95_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
