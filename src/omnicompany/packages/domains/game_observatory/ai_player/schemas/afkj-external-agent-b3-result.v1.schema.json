      "title": "Id",
      "type": "string"
    },
    "important_recall": {
      "maximum": 1,
      "minimum": 0,
      "title": "Important Recall",
      "type": "number"
    },
    "precision": {
      "maximum": 1,
      "minimum": 0,
      "title": "Precision",
      "type": "number"
    },
    "provider": {
      "enum": [
        "codex-cli",
        "claude-code-cli"
      ],
      "title": "Provider",
      "type": "string"
    },
    "raw_runtime_root": {
      "title": "Raw Runtime Root",
      "type": "string"
    },
    "repetition": {
      "minimum": 1,
      "title": "Repetition",
      "type": "integer"
    },
    "requested_case_count": {
      "maximum": 10,
      "minimum": 1,
      "title": "Requested Case Count",
      "type": "integer"
    },
    "requested_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Requested Case Ids",
      "type": "array"
    },
    "requested_effort": {
      "const": "medium",
      "default": "medium",
      "title": "Requested Effort",
      "type": "string"
    },
    "requested_model_selector": {
      "title": "Requested Model Selector",
      "type": "string"
    },
    "safety_violation_count": {
      "minimum": 0,
      "title": "Safety Violation Count",
      "type": "integer"
    },
    "same_native_session": {
      "title": "Same Native Session",
      "type": "boolean"
    },
    "schema": {
      "const": "game-observatory.ai-player.afkj-external-agent-b3-result.v1",
      "default": "game-observatory.ai-player.afkj-external-agent-b3-result.v1",
      "title": "Schema",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "const": "B3",
      "default": "B3",
      "title": "Task Id",
      "type": "string"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/ExternalAgentBenchmarkTurnV1"
      },
      "title": "Turns",
      "type": "array"
    },
    "unmatched_proposal_count": {
      "minimum": 0,
      "title": "Unmatched Proposal Count",
      "type": "integer"
    },
    "unmatched_proposal_rate": {
      "maximum": 1,
      "minimum": 0,
      "title": "Unmatched Proposal Rate",
      "type": "number"
    },
    "unmatched_semantics": {
      "const": "offline_expected_probe_proxy_not_real_misclicks",
      "default": "offline_expected_probe_proxy_not_real_misclicks",
      "title": "Unmatched Semantics",
      "type": "string"
    },
    "warm_exclusion_status": {
      "const": "unproven",
      "default": "unproven",
      "title": "Warm Exclusion Status",
      "type": "string"
    }
