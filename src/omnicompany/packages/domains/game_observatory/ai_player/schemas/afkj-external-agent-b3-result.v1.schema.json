{
  "$defs": {
    "AFKJB3CaseResultV1": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^B3-[0-9]{2}$",
          "title": "Case Id",
          "type": "string"
        },
        "execution_guard_correct": {
          "title": "Execution Guard Correct",
          "type": "boolean"
        },
        "invocation_id": {
          "title": "Invocation Id",
          "type": "string"
        },
        "matched_proposal_count": {
          "minimum": 0,
          "title": "Matched Proposal Count",
          "type": "integer"
        },
        "predicted_routing_layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Routing Layer"
        },
        "predicted_would_execute": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Would Execute"
        },
        "proposal_ledger_path": {
          "title": "Proposal Ledger Path",
          "type": "string"
        },
        "response_parseable": {
          "title": "Response Parseable",
          "type": "boolean"
        },
        "routing_correct": {
          "title": "Routing Correct",
          "type": "boolean"
        },
        "score": {
          "$ref": "#/$defs/ExplorationBenchmarkScore"
        },
        "unmatched_proposal_count": {
          "minimum": 0,
          "title": "Unmatched Proposal Count",
          "type": "integer"
        },
        "unmatched_proposal_rate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Unmatched Proposal Rate",
          "type": "number"
        }
      },
      "required": [
        "case_id",
        "invocation_id",
        "response_parseable",
        "routing_correct",
        "execution_guard_correct",
        "proposal_ledger_path",
        "score",
        "matched_proposal_count",
        "unmatched_proposal_count",
        "unmatched_proposal_rate"
      ],
      "title": "AFKJB3CaseResultV1",
      "type": "object"
    },
    "ExplorationBenchmarkScore": {
      "properties": {
        "duplicate_rate": {
          "title": "Duplicate Rate",
          "type": "number"
        },
        "elapsed_seconds": {
          "minimum": 0,
          "title": "Elapsed Seconds",
          "type": "number"
        },
        "eligible_proposal_count": {
          "title": "Eligible Proposal Count",
          "type": "integer"
        },
        "evidence_complete_rate": {
          "title": "Evidence Complete Rate",
          "type": "number"
        },
        "expected_recall": {
          "title": "Expected Recall",
          "type": "number"
        },
        "fixture_id": {
          "title": "Fixture Id",
          "type": "string"
        },
        "generated_at": {
          "title": "Generated At",
          "type": "string"
        },
        "geometry_failure_count": {
          "title": "Geometry Failure Count",
          "type": "integer"
        },
        "human_intervention_seconds": {
          "minimum": 0,
          "title": "Human Intervention Seconds",
          "type": "number"
        },
        "important_recall": {
          "title": "Important Recall",
          "type": "number"
        },
        "issues": {
          "items": {
            "type": "string"
          },
          "title": "Issues",
          "type": "array"
        },
        "matched_expected_ids": {
          "items": {
            "type": "string"
          },
          "title": "Matched Expected Ids",
          "type": "array"
        },
        "matched_important_ids": {
          "items": {
            "type": "string"
          },
          "title": "Matched Important Ids",
          "type": "array"
        },
        "missing_expected_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missing Expected Ids",
          "type": "array"
        },
        "missing_important_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missing Important Ids",
          "type": "array"
        },
        "path": {
          "enum": [
            "manual",
            "hypothesis"
          ],
          "title": "Path",
          "type": "string"
        },
        "precision": {
          "title": "Precision",
          "type": "number"
        },
        "proposal_count": {
          "title": "Proposal Count",
          "type": "integer"
        },
        "safety_violation_count": {
          "title": "Safety Violation Count",
          "type": "integer"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "unsupported_fact_count": {
          "title": "Unsupported Fact Count",
          "type": "integer"
        },
        "verified_novel_transition_count": {
          "title": "Verified Novel Transition Count",
          "type": "integer"
        }
      },
      "required": [
        "fixture_id",
        "path",
        "proposal_count",
        "eligible_proposal_count",
        "matched_expected_ids",
        "missing_expected_ids",
        "matched_important_ids",
        "missing_important_ids",
        "expected_recall",
        "important_recall",
        "precision",
        "evidence_complete_rate",
        "duplicate_rate",
        "safety_violation_count",
        "geometry_failure_count",
        "unsupported_fact_count",
        "verified_novel_transition_count",
        "human_intervention_seconds",
        "elapsed_seconds"
      ],
      "title": "ExplorationBenchmarkScore",
      "type": "object"
    },
    "ExternalAgentBenchmarkTurnV1": {
      "additionalProperties": false,
      "properties": {
        "actual_effort": {
          "title": "Actual Effort",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "effort_evidence": {
          "title": "Effort Evidence",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "event_log_path": {
          "title": "Event Log Path",
          "type": "string"
        },
        "event_log_sha256": {
          "title": "Event Log Sha256",
          "type": "string"
        },
        "external_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Session Id"
        },
        "input_images": {
          "items": {
            "$ref": "#/$defs/ExternalAgentImageInputV1"
          },
          "title": "Input Images",
          "type": "array"
        },
        "invocation_id": {
          "title": "Invocation Id",
          "type": "string"
        },
        "last_message_path": {
          "title": "Last Message Path",
          "type": "string"
        },
        "last_message_sha256": {
          "title": "Last Message Sha256",
          "type": "string"
        },
        "model_evidence": {
          "title": "Model Evidence",
          "type": "string"
        },
        "operation": {
          "enum": [
            "start",
            "resume"
          ],
          "title": "Operation",
          "type": "string"
        },
        "provider_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Cost Usd"
        },
        "provider_duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Duration Seconds"
        },
        "resolved_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved Model Id"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
