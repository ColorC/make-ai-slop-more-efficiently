    "diagnostic_quality_pass": {
      "title": "Diagnostic Quality Pass",
      "type": "boolean"
    },
    "evidence_complete_rate": {
      "maximum": 1,
      "minimum": 0,
      "title": "Evidence Complete Rate",
      "type": "number"
    },
    "expected_recall": {
      "maximum": 1,
      "minimum": 0,
      "title": "Expected Recall",
      "type": "number"
    },
    "external_session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "External Session Id"
