    "interface_family_ids": {
      "items": {
        "type": "string"
      },
      "title": "Interface Family Ids",
      "type": "array"
    },
    "main_state_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Main State Ids",
      "type": "array"
    },
    "resource_or_progression_clues": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Resource Or Progression Clues",
      "type": "array"
    },
    "rule_clues": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Rule Clues",
      "type": "array"
    },
    "schema": {
      "const": "game-observatory.ai-player.gameplay-candidate.v1",
