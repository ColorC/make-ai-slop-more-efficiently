  "required": [
    "environment_id",
    "evidence_refs",
    "id",
    "game_id",
    "title",
    "triggering_task_ids",
    "entry_state_ids",
    "main_state_ids",
    "transition_edge_ids",
    "rule_clues",
    "resource_or_progression_clues",
    "boundary_summary"
  ],
  "title": "GameplayCandidateV1",
  "type": "object"
}
