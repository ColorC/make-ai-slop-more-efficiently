      "title": "Evidence Refs",
      "type": "array"
    },
    "exit_state_ids": {
      "items": {
        "type": "string"
      },
      "title": "Exit State Ids",
      "type": "array"
    },
    "game_id": {
      "minLength": 1,
      "title": "Game Id",
      "type": "string"
    },
    "id": {
      "minLength": 1,
