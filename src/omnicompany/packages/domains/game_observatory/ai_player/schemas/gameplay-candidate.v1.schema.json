      "type": "array"
    },
    "adjacent_gameplay_labels": {
      "items": {
        "type": "string"
      },
      "title": "Adjacent Gameplay Labels",
      "type": "array"
    },
    "boundary_summary": {
      "minLength": 1,
      "title": "Boundary Summary",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "entry_state_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Entry State Ids",
      "type": "array"
