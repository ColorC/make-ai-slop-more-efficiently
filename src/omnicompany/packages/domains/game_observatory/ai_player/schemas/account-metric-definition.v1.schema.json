{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stable interpretation policy fixed before reading either observation.",
  "properties": {
    "category": {
      "enum": [
        "account_progression",
        "resource",
        "objective",
        "coverage"
      ],
      "title": "Category",
      "type": "string"
    },
    "game_id": {
      "minLength": 1,
      "title": "Game Id",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "improvement_direction": {
      "enum": [
        "higher_is_favorable",
        "lower_is_favorable",
        "track_only"
      ],
      "title": "Improvement Direction",
      "type": "string"
    },
    "label": {
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "maximum_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Maximum Value"
    },
    "metric_key": {
      "minLength": 1,
      "title": "Metric Key",
      "type": "string"
    },
    "minimum_ocr_confidence": {
      "default": 0.9,
      "maximum": 1,
      "minimum": 0.5,
      "title": "Minimum Ocr Confidence",
      "type": "number"
    },
    "minimum_value": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Minimum Value"
    },
    "numeric_format": {
      "enum": [
        "integer",
        "decimal",
        "percentage",
        "compact_zh"
      ],
      "title": "Numeric Format",
      "type": "string"
    },
    "schema": {
      "const": "game-observatory.ai-player.account-metric-definition.v1",
      "default": "game-observatory.ai-player.account-metric-definition.v1",
      "title": "Schema",
      "type": "string"
    },
    "unit": {
      "minLength": 1,
      "title": "Unit",
      "type": "string"
    }
  },
  "required": [
    "id",
    "game_id",
    "metric_key",
    "label",
    "category",
    "unit",
    "numeric_format",
    "improvement_direction"
  ],
  "title": "AccountMetricDefinitionV1",
  "type": "object"
}
