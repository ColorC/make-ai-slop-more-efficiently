{
  "$defs": {
    "EvidenceReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "evidence_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Run Ids",
          "type": "array"
        },
        "evidence_step_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Step Ids",
          "type": "array"
        },
        "note": {
          "default": "",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        },
        "schema": {
          "const": "game-observatory.ai-player.evidence-reference.v1",
          "default": "game-observatory.ai-player.evidence-reference.v1",
          "title": "Schema",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "trace_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Trace Run Ids",
          "type": "array"
        }
      },
      "required": [
        "environment_id"
      ],
      "title": "EvidenceReferenceV1",
      "type": "object"
    },
    "NormalizedAction": {
      "properties": {
        "axis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Axis"
        },
        "button": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Button"
        },
        "duration_ms": {
          "default": 250,
          "title": "Duration Ms",
          "type": "integer"
        },
        "keycode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Keycode"
        },
        "package": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package"
        },
        "pinch_direction": {
          "anyOf": [
            {
              "enum": [
                "in",
                "out"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pinch Direction"
        },
        "pinch_percent": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pinch Percent"
        },
        "pinch_steps": {
          "default": 5,
          "maximum": 60,
          "minimum": 2,
          "title": "Pinch Steps",
          "type": "integer"
        },
        "pressed": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pressed"
        },
        "seconds": {
          "default": 0.5,
          "title": "Seconds",
          "type": "number"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "two_finger_offset_x": {
          "default": 0,
          "maximum": 4096,
          "minimum": -4096,
          "title": "Two Finger Offset X",
          "type": "integer"
        },
        "two_finger_offset_y": {
          "default": 50,
          "maximum": 4096,
          "minimum": -4096,
          "title": "Two Finger Offset Y",
          "type": "integer"
        },
        "two_finger_steps": {
          "default": 5,
          "maximum": 60,
          "minimum": 2,
          "title": "Two Finger Steps",
          "type": "integer"
        },
        "type": {
          "enum": [
            "tap",
            "swipe",
            "pinch",
            "two_finger_swipe",
            "text",
            "key",
            "launch",
            "force_stop",
            "wait",
            "back",
            "home",
            "mouse_move",
            "mouse_button",
            "gamepad_button",
            "gamepad_axis",
            "reset"
          ],
          "title": "Type",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": -1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "x": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "x2": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X2"
        },
        "y": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        },
        "y2": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y2"
        }
      },
      "required": [
        "type"
      ],
      "title": "NormalizedAction",
      "type": "object"
    },
    "PendingActionV1": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/NormalizedAction"
        },
        "action_run_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Action Run Id"
        },
        "after_evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReferenceV1"
          },
          "title": "After Evidence Refs",
          "type": "array"
        },
        "blind_replay_allowed": {
          "const": false,
          "default": false,
          "title": "Blind Replay Allowed",
          "type": "boolean"
        },
        "effect_checked_at": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effect Checked At"
        },
        "effect_status": {
          "default": "unknown",
          "enum": [
            "unknown",
            "confirmed",
            "failed"
          ],
          "title": "Effect Status",
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReferenceV1"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "intent": {
          "minLength": 1,
          "title": "Intent",
          "type": "string"
        },
        "issued_at": {
          "title": "Issued At",
          "type": "string"
        },
        "request_sha256": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Sha256"
        },
        "result_summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Summary"
        },
        "resume_rule": {
          "default": "reobserve_before_any_action",
          "enum": [
            "reobserve_before_any_action",
            "do_not_replay"
          ],
          "title": "Resume Rule",
          "type": "string"
        },
        "schema": {
          "const": "game-observatory.ai-player.pending-action.v1",
          "default": "game-observatory.ai-player.pending-action.v1",
          "title": "Schema",
          "type": "string"
        }
      },
      "required": [
        "environment_id",
        "evidence_refs",
        "id",
        "intent",
        "action"
      ],
      "title": "PendingActionV1",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "active_task_ids": {
      "items": {
        "type": "string"
      },
      "title": "Active Task Ids",
      "type": "array"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "device_lease_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Device Lease Id"
    },
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceReferenceV1"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "known_external_side_effects": {
      "items": {
        "type": "string"
      },
      "title": "Known External Side Effects",
      "type": "array"
    },
    "last_confirmed_state_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Confirmed State Id"
    },
    "pending_action": {
      "anyOf": [
        {
          "$ref": "#/$defs/PendingActionV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pending_frontier_task_ids": {
      "items": {
        "type": "string"
      },
      "title": "Pending Frontier Task Ids",
      "type": "array"
    },
    "remaining_action_budget": {
      "minimum": 0,
      "title": "Remaining Action Budget",
      "type": "integer"
    },
    "remaining_time_seconds": {
      "minimum": 0,
      "title": "Remaining Time Seconds",
      "type": "number"
    },
    "remaining_token_budget": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Remaining Token Budget"
    },
    "schema": {
      "const": "game-observatory.ai-player.session-capsule.v1",
      "default": "game-observatory.ai-player.session-capsule.v1",
      "title": "Schema",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "session_id": {
      "minLength": 1,
      "title": "Session Id",
      "type": "string"
    },
    "stop_reason": {
      "minLength": 1,
      "title": "Stop Reason",
      "type": "string"
    },
    "subgoal_stack": {
      "items": {
        "type": "string"
      },
      "title": "Subgoal Stack",
      "type": "array"
    }
  },
  "required": [
    "environment_id",
    "evidence_refs",
    "id",
    "session_id",
    "sequence",
    "remaining_action_budget",
    "remaining_time_seconds",
    "stop_reason"
  ],
  "title": "SessionCapsuleV1",
  "type": "object"
}
