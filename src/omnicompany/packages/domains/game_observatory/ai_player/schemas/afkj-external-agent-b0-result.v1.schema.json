{
  "$defs": {
    "ExternalAgentBenchmarkTurnV1": {
      "additionalProperties": false,
      "properties": {
        "actual_effort": {
          "title": "Actual Effort",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "effort_evidence": {
          "title": "Effort Evidence",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "event_log_path": {
          "title": "Event Log Path",
          "type": "string"
        },
        "event_log_sha256": {
          "title": "Event Log Sha256",
          "type": "string"
        },
        "external_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Session Id"
        },
        "input_images": {
          "items": {
            "$ref": "#/$defs/ExternalAgentImageInputV1"
          },
          "title": "Input Images",
          "type": "array"
        },
        "invocation_id": {
          "title": "Invocation Id",
          "type": "string"
        },
        "last_message_path": {
          "title": "Last Message Path",
          "type": "string"
        },
        "last_message_sha256": {
          "title": "Last Message Sha256",
          "type": "string"
        },
        "model_evidence": {
          "title": "Model Evidence",
          "type": "string"
        },
        "operation": {
          "enum": [
            "start",
            "resume"
          ],
          "title": "Operation",
          "type": "string"
        },
        "provider_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Cost Usd"
        },
        "provider_duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Duration Seconds"
        },
        "resolved_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved Model Id"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "time_to_first_token_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time To First Token Seconds"
        },
        "timeout_reason": {
          "anyOf": [
            {
              "enum": [
                "hard_wall_clock",
                "no_meaningful_progress"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Reason"
        },
        "unexpected_tool_events": {
          "minimum": 0,
          "title": "Unexpected Tool Events",
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/ExternalAgentTokenUsageV1"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        }
      },
      "required": [
        "invocation_id",
        "operation",
        "status",
        "external_session_id",
        "resolved_model_id",
        "model_evidence",
        "actual_effort",
        "effort_evidence",
        "duration_seconds",
        "provider_duration_seconds",
        "time_to_first_token_seconds",
        "provider_cost_usd",
        "usage",
        "unexpected_tool_events",
        "warning_count",
        "event_log_path",
        "event_log_sha256",
        "last_message_path",
        "last_message_sha256"
      ],
      "title": "ExternalAgentBenchmarkTurnV1",
      "type": "object"
    },
    "ExternalAgentImageInputV1": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "size_bytes"
      ],
      "title": "ExternalAgentImageInputV1",
      "type": "object"
    },
    "ExternalAgentTokenUsageV1": {
      "additionalProperties": false,
      "properties": {
        "cache_creation_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        }
      },
      "title": "ExternalAgentTokenUsageV1",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "b0_correct": {
      "maximum": 10,
      "minimum": 0,
      "title": "B0 Correct",
      "type": "integer"
    },
    "b0_total": {
      "const": 10,
      "default": 10,
      "title": "B0 Total",
      "type": "integer"
    },
    "benchmark_id": {
      "const": "afkj_external_agent_continuity_v1",
      "title": "Benchmark Id",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "completed_at": {
      "title": "Completed At",
      "type": "string"
    },
    "continuity_token_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Continuity Token Sha256",
      "type": "string"
    },
    "external_session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "External Session Id"
    },
    "facility_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Facility Contract Sha256",
      "type": "string"
    },
    "fixture_freeze_status": {
      "title": "Fixture Freeze Status",
      "type": "string"
    },
    "fixture_manifest_path": {
      "title": "Fixture Manifest Path",
      "type": "string"
    },
    "fixture_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixture Manifest Sha256",
      "type": "string"
    },
    "fixture_semantic_status": {
      "title": "Fixture Semantic Status",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "provider": {
      "enum": [
        "codex-cli",
        "claude-code-cli"
      ],
