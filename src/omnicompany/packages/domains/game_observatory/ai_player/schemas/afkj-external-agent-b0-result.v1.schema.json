      "type": "string"
    },
    "quality_failures": {
      "items": {
        "type": "string"
      },
      "title": "Quality Failures",
      "type": "array"
    },
    "quality_pass": {
      "title": "Quality Pass",
      "type": "boolean"
    },
    "raw_runtime_root": {
      "title": "Raw Runtime Root",
      "type": "string"
    },
    "repetition": {
      "minimum": 1,
      "title": "Repetition",
      "type": "integer"
    },
    "requested_effort": {
      "const": "medium",
      "title": "Requested Effort",
      "type": "string"
    },
    "requested_model_selector": {
      "title": "Requested Model Selector",
      "type": "string"
    },
    "same_native_session": {
      "title": "Same Native Session",
      "type": "boolean"
    },
    "schema": {
      "const": "game-observatory.ai-player.afkj-external-agent-b0-result.v1",
      "default": "game-observatory.ai-player.afkj-external-agent-b0-result.v1",
      "title": "Schema",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "task_id": {
      "const": "B0",
      "default": "B0",
      "title": "Task Id",
      "type": "string"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/ExternalAgentBenchmarkTurnV1"
      },
      "title": "Turns",
      "type": "array"
    },
    "warm_probe_correct": {
      "maximum": 4,
      "minimum": 0,
