  "required": [
    "id",
    "benchmark_id",
    "candidate_id",
    "repetition",
    "facility_contract_sha256",
    "fixture_manifest_path",
    "fixture_manifest_sha256",
    "fixture_semantic_status",
    "fixture_freeze_status",
    "provider",
    "requested_model_selector",
    "requested_effort",
    "external_session_id",
    "continuity_token_sha256",
    "b0_correct",
    "warm_probe_correct",
    "same_native_session",
    "quality_pass",
    "quality_failures",
    "turns",
    "raw_runtime_root",
    "status",
    "started_at",
    "completed_at"
  ],
  "title": "AFKJB0BenchmarkResultV1",
  "type": "object"
}
