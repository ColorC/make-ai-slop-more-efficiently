{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "artifact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Ids",
      "type": "array"
    },
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "evidence_run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Run Ids",
      "type": "array"
    },
    "evidence_step_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Step Ids",
      "type": "array"
    },
    "note": {
      "default": "",
      "maxLength": 2000,
      "title": "Note",
      "type": "string"
    },
    "schema": {
      "const": "game-observatory.ai-player.evidence-reference.v1",
      "default": "game-observatory.ai-player.evidence-reference.v1",
      "title": "Schema",
      "type": "string"
    },
    "source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "trace_run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Trace Run Ids",
      "type": "array"
    }
  },
  "required": [
    "environment_id"
  ],
  "title": "EvidenceReferenceV1",
  "type": "object"
}
