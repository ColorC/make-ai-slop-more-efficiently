          "independent_reviewer": {
            "const": false
          },
          "reviewed_at": {
            "type": "null"
          },
          "reviewed_evidence_root_sha256": {
            "type": "null"
          },
          "reviewed_item_ids": {
            "maxItems": 0
          },
          "reviewed_receipt_root_sha256": {
            "type": "null"
          },
          "reviewer_id": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "category": {
            "const": "independent_review"
          }
        },
        "required": [
          "category"
        ]
      },
      "then": {
        "properties": {
          "independent_reviewer": {
            "const": true
          }
        },
        "required": [
          "independent_reviewer",
          "reviewer_id",
          "reviewed_item_ids",
          "reviewed_at",
          "reviewed_receipt_root_sha256",
          "reviewed_evidence_root_sha256"
