  "required": [
    "receipt_id",
    "category",
    "item_id",
    "status",
    "issuer_id",
    "summary",
    "blocker_count",
    "major_count",
    "safety_violation_count",
    "evidence_refs",
    "manifest_sha256",
    "key_id",
    "signature_algorithm",
    "signature_base64",
