        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed Evidence Root Sha256"
    },
    "reviewed_item_ids": {
      "items": {
        "type": "string"
      },
      "title": "Reviewed Item Ids",
      "type": "array",
      "uniqueItems": true
    },
    "reviewed_receipt_root_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewed Receipt Root Sha256"
    },
    "reviewer_id": {
      "anyOf": [
        {
          "minLength": 1,
