{
  "$defs": {
    "EvidenceReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "evidence_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Run Ids",
          "type": "array"
        },
        "evidence_step_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Step Ids",
          "type": "array"
        },
        "note": {
          "default": "",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        },
        "schema": {
          "const": "game-observatory.ai-player.evidence-reference.v1",
          "default": "game-observatory.ai-player.evidence-reference.v1",
          "title": "Schema",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "trace_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Trace Run Ids",
          "type": "array"
        }
      },
      "required": [
        "environment_id"
      ],
      "title": "EvidenceReferenceV1",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Confidence",
      "type": "number"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceReferenceV1"
      },
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "method": {
      "enum": [
        "exact_fingerprint",
        "nearest_prototype",
        "source_state_guard",
        "expected_state_guard",
        "new_candidate",
        "adjudicated_merge",
        "adjudicated_split",
        "recovery_recheck"
      ],
      "title": "Method",
      "type": "string"
    },
    "observation_id": {
      "minLength": 1,
      "title": "Observation Id",
      "type": "string"
    },
    "reasons": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Reasons",
      "type": "array"
    },
    "schema": {
      "const": "game-observatory.ai-player.state-assignment.v1",
      "default": "game-observatory.ai-player.state-assignment.v1",
      "title": "Schema",
      "type": "string"
    },
    "state_id": {
      "minLength": 1,
      "title": "State Id",
      "type": "string"
    },
    "status": {
      "default": "active",
      "enum": [
        "active",
        "superseded",
        "invalidated"
      ],
      "title": "Status",
      "type": "string"
    },
    "supersedes_id": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Id"
    },
    "version": {
      "default": 1,
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "environment_id",
    "evidence_refs",
    "id",
    "observation_id",
    "state_id",
    "method",
    "confidence",
    "reasons"
  ],
  "title": "StateAssignmentV1",
  "type": "object"
}
