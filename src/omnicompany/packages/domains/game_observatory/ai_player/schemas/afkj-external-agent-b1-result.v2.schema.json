{
  "$defs": {
    "AFKJB1CaseResultV1": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "pattern": "^B1-[0-9]{2}$",
          "title": "Case Id",
          "type": "string"
        },
        "effective_target_x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Target X"
        },
        "effective_target_y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Target Y"
        },
        "execution_guard_correct": {
          "title": "Execution Guard Correct",
          "type": "boolean"
        },
        "invocation_id": {
          "title": "Invocation Id",
          "type": "string"
        },
        "locator_applied": {
          "default": false,
          "title": "Locator Applied",
          "type": "boolean"
        },
        "object_correct": {
          "default": false,
          "title": "Object Correct",
          "type": "boolean"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "predicted_object_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Object Id"
        },
        "predicted_routing_layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Routing Layer"
        },
        "predicted_state_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted State Id"
        },
        "predicted_target_x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Target X"
        },
        "predicted_target_y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Target Y"
        },
        "predicted_would_execute": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Predicted Would Execute"
        },
        "raw_target_hit": {
          "default": false,
          "title": "Raw Target Hit",
          "type": "boolean"
        },
        "response_parseable": {
          "title": "Response Parseable",
          "type": "boolean"
        },
        "routing_correct": {
          "title": "Routing Correct",
          "type": "boolean"
        },
        "state_correct": {
          "title": "State Correct",
          "type": "boolean"
        },
        "target_hit": {
          "title": "Target Hit",
          "type": "boolean"
        },
        "underlay_mispoint": {
          "title": "Underlay Mispoint",
          "type": "boolean"
        }
      },
      "required": [
        "case_id",
        "invocation_id",
        "response_parseable",
        "state_correct",
        "target_hit",
        "routing_correct",
        "execution_guard_correct",
        "underlay_mispoint",
        "passed"
      ],
      "title": "AFKJB1CaseResultV1",
      "type": "object"
    },
    "ExternalAgentBenchmarkTurnV1": {
      "additionalProperties": false,
      "properties": {
        "actual_effort": {
          "title": "Actual Effort",
          "type": "string"
        },
        "duration_seconds": {
          "title": "Duration Seconds",
          "type": "number"
        },
        "effort_evidence": {
          "title": "Effort Evidence",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error"
        },
        "event_log_path": {
          "title": "Event Log Path",
          "type": "string"
        },
        "event_log_sha256": {
          "title": "Event Log Sha256",
          "type": "string"
        },
        "external_session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "External Session Id"
        },
        "input_images": {
          "items": {
            "$ref": "#/$defs/ExternalAgentImageInputV1"
          },
          "title": "Input Images",
          "type": "array"
        },
        "invocation_id": {
          "title": "Invocation Id",
          "type": "string"
        },
        "last_message_path": {
          "title": "Last Message Path",
          "type": "string"
        },
        "last_message_sha256": {
          "title": "Last Message Sha256",
          "type": "string"
        },
        "model_evidence": {
          "title": "Model Evidence",
          "type": "string"
        },
        "operation": {
          "enum": [
            "start",
            "resume"
          ],
          "title": "Operation",
          "type": "string"
        },
        "provider_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Cost Usd"
        },
        "provider_duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Provider Duration Seconds"
        },
        "resolved_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Resolved Model Id"
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "timed_out"
          ],
          "title": "Status",
          "type": "string"
        },
        "time_to_first_token_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time To First Token Seconds"
        },
        "timeout_reason": {
          "anyOf": [
            {
              "enum": [
                "hard_wall_clock",
                "no_meaningful_progress"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timeout Reason"
        },
        "unexpected_tool_events": {
          "minimum": 0,
          "title": "Unexpected Tool Events",
          "type": "integer"
        },
        "usage": {
          "$ref": "#/$defs/ExternalAgentTokenUsageV1"
        },
        "warning_count": {
          "minimum": 0,
          "title": "Warning Count",
          "type": "integer"
        }
      },
      "required": [
        "invocation_id",
        "operation",
        "status",
        "external_session_id",
        "resolved_model_id",
        "model_evidence",
        "actual_effort",
        "effort_evidence",
        "duration_seconds",
        "provider_duration_seconds",
        "time_to_first_token_seconds",
        "provider_cost_usd",
        "usage",
        "unexpected_tool_events",
        "warning_count",
        "event_log_path",
        "event_log_sha256",
        "last_message_path",
        "last_message_sha256"
      ],
      "title": "ExternalAgentBenchmarkTurnV1",
      "type": "object"
    },
    "ExternalAgentImageInputV1": {
      "additionalProperties": false,
      "properties": {
        "media_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/gif",
            "image/webp"
          ],
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "exclusiveMinimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "media_type",
        "size_bytes"
      ],
      "title": "ExternalAgentImageInputV1",
      "type": "object"
    },
    "ExternalAgentTokenUsageV1": {
      "additionalProperties": false,
      "properties": {
        "cache_creation_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cached_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cached Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "reasoning_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Reasoning Tokens",
          "type": "integer"
        }
      },
      "title": "ExternalAgentTokenUsageV1",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "benchmark_id": {
      "const": "afkj_external_agent_continuity_v1",
      "title": "Benchmark Id",
      "type": "string"
    },
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/AFKJB1CaseResultV1"
      },
      "title": "Cases",
      "type": "array"
    },
    "complete_case_set": {
      "title": "Complete Case Set",
      "type": "boolean"
    },
    "completed_at": {
      "title": "Completed At",
      "type": "string"
    },
    "completed_case_count": {
      "maximum": 20,
      "minimum": 0,
      "title": "Completed Case Count",
      "type": "integer"
    },
    "decision_p50_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision P50 Seconds"
    },
    "decision_p95_seconds": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Decision P95 Seconds"
    },
    "execution_guard_correct": {
      "maximum": 20,
      "minimum": 0,
      "title": "Execution Guard Correct",
      "type": "integer"
    },
    "external_session_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "External Session Id"
    },
    "facility_contract_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Facility Contract Sha256",
      "type": "string"
    },
    "fixture_freeze_status": {
      "const": "not_frozen",
      "title": "Fixture Freeze Status",
      "type": "string"
    },
    "fixture_path": {
      "title": "Fixture Path",
      "type": "string"
    },
    "fixture_semantic_status": {
      "const": "candidate",
      "title": "Fixture Semantic Status",
      "type": "string"
    },
    "fixture_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fixture Sha256",
      "type": "string"
    },
    "formal_quality_eligible": {
      "title": "Formal Quality Eligible",
      "type": "boolean"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "object_correct": {
      "default": 0,
      "maximum": 20,
      "minimum": 0,
      "title": "Object Correct",
      "type": "integer"
    },
    "provider": {
      "enum": [
        "codex-cli",
        "claude-code-cli"
      ],
      "title": "Provider",
      "type": "string"
    },
    "quality_failures": {
      "items": {
        "type": "string"
      },
      "title": "Quality Failures",
      "type": "array"
    },
    "quality_pass": {
      "title": "Quality Pass",
      "type": "boolean"
    },
    "raw_runtime_root": {
      "title": "Raw Runtime Root",
      "type": "string"
    },
    "raw_target_estimate_count": {
      "default": 0,
      "maximum": 20,
      "minimum": 0,
      "title": "Raw Target Estimate Count",
      "type": "integer"
    },
    "raw_target_hits": {
      "default": 0,
      "maximum": 20,
      "minimum": 0,
      "title": "Raw Target Hits",
      "type": "integer"
    },
    "repetition": {
      "minimum": 1,
      "title": "Repetition",
      "type": "integer"
    },
    "requested_case_count": {
      "maximum": 20,
      "minimum": 1,
      "title": "Requested Case Count",
      "type": "integer"
    },
    "requested_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Requested Case Ids",
      "type": "array"
    },
    "requested_effort": {
      "const": "medium",
      "title": "Requested Effort",
      "type": "string"
    },
    "requested_model_selector": {
      "title": "Requested Model Selector",
      "type": "string"
    },
    "routing_correct": {
      "maximum": 20,
      "minimum": 0,
      "title": "Routing Correct",
      "type": "integer"
    },
    "same_native_session": {
      "title": "Same Native Session",
      "type": "boolean"
    },
    "schema": {
      "default": "game-observatory.ai-player.afkj-external-agent-b1-result.v2",
      "enum": [
        "game-observatory.ai-player.afkj-external-agent-b1-result.v1",
        "game-observatory.ai-player.afkj-external-agent-b1-result.v2"
      ],
      "title": "Schema",
      "type": "string"
    },
    "scoring_profile": {
      "default": "layered-locator-v2",
      "enum": [
        "legacy-freehand-v1",
        "layered-locator-v2"
      ],
      "title": "Scoring Profile",
      "type": "string"
    },
    "started_at": {
      "title": "Started At",
      "type": "string"
    },
    "state_correct": {
      "maximum": 20,
      "minimum": 0,
      "title": "State Correct",
      "type": "integer"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "target_hits": {
      "maximum": 20,
      "minimum": 0,
      "title": "Target Hits",
      "type": "integer"
    },
    "task_id": {
      "const": "B1",
      "default": "B1",
      "title": "Task Id",
      "type": "string"
    },
    "turns": {
      "items": {
        "$ref": "#/$defs/ExternalAgentBenchmarkTurnV1"
      },
      "title": "Turns",
      "type": "array"
    },
    "underlay_mispoint_count": {
      "minimum": 0,
      "title": "Underlay Mispoint Count",
      "type": "integer"
    }
  },
  "required": [
    "id",
    "benchmark_id",
    "candidate_id",
    "repetition",
    "facility_contract_sha256",
    "fixture_path",
    "fixture_sha256",
    "fixture_semantic_status",
    "fixture_freeze_status",
    "provider",
    "requested_model_selector",
    "requested_effort",
    "external_session_id",
    "requested_case_count",
    "requested_case_ids",
    "completed_case_count",
    "complete_case_set",
    "formal_quality_eligible",
    "state_correct",
    "target_hits",
    "routing_correct",
    "execution_guard_correct",
    "underlay_mispoint_count",
    "same_native_session",
    "quality_pass",
    "quality_failures",
    "cases",
    "turns",
    "raw_runtime_root",
    "status",
    "started_at",
    "completed_at"
  ],
  "title": "AFKJB1BenchmarkResultV1",
  "type": "object"
}
