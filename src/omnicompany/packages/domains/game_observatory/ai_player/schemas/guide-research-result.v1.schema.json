{
  "$defs": {
    "EvidenceReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "evidence_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Run Ids",
          "type": "array"
        },
        "evidence_step_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Step Ids",
          "type": "array"
        },
        "note": {
          "default": "",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        },
        "schema": {
          "const": "game-observatory.ai-player.evidence-reference.v1",
          "default": "game-observatory.ai-player.evidence-reference.v1",
          "title": "Schema",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "trace_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Trace Run Ids",
          "type": "array"
        }
      },
      "required": [
        "environment_id"
      ],
      "title": "EvidenceReferenceV1",
      "type": "object"
    },
    "GuideKnowledgeV1": {
      "additionalProperties": false,
      "properties": {
        "applicable_account_scope_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicable Account Scope Id"
        },
        "applicable_build_scope_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicable Build Scope Id"
        },
        "applicable_channel": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicable Channel"
        },
        "applicable_game_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Applicable Game Version"
        },
        "author": {
          "minLength": 1,
          "title": "Author",
          "type": "string"
        },
        "contradiction_summary": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contradiction Summary"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReferenceV1"
          },
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "fresh_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fresh Until"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "live_contradiction_evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReferenceV1"
          },
          "title": "Live Contradiction Evidence Refs",
          "type": "array"
        },
        "locators": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Locators",
          "type": "array"
        },
        "missing_applicability_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Missing Applicability Reason"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "retrieved_at": {
          "minLength": 1,
          "title": "Retrieved At",
          "type": "string"
        },
        "schema": {
          "const": "game-observatory.ai-player.guide-knowledge.v1",
          "default": "game-observatory.ai-player.guide-knowledge.v1",
          "title": "Schema",
          "type": "string"
        },
        "season": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season"
        },
        "server_stage": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Stage"
        },
        "stale_reason": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stale Reason"
        },
        "status": {
          "default": "unverified",
          "enum": [
            "current",
            "unverified",
            "stale",
            "contradicted"
          ],
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "triggering_task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Triggering Task Ids",
          "type": "array"
        },
        "updated_at": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "version": {
          "default": 1,
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "environment_id",
        "evidence_refs",
        "id",
        "url",
        "platform",
        "author",
        "retrieved_at",
        "summary",
        "locators"
      ],
      "title": "GuideKnowledgeV1",
      "type": "object"
    },
    "GuideSourceMetadataV1": {
      "additionalProperties": false,
      "description": "Required provenance stored inside every source snapshot.",
      "properties": {
        "author": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "author_or_publisher": {
          "minLength": 1,
          "title": "Author Or Publisher",
          "type": "string"
        },
        "citation_locator": {
          "minLength": 1,
          "title": "Citation Locator",
          "type": "string"
        },
        "game_version": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Game Version"
        },
        "platform": {
          "minLength": 1,
          "title": "Platform",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "publisher": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publisher"
        },
        "research_record_id": {
          "minLength": 1,
          "title": "Research Record Id",
          "type": "string"
        },
        "retrieved_at": {
          "format": "date-time",
          "title": "Retrieved At",
          "type": "string"
        },
        "season": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Season"
        },
        "server_stage": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Server Stage"
        },
        "updated_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Updated At"
        },
        "url": {
          "format": "uri",
          "maxLength": 2083,
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "url",
        "platform",
        "author_or_publisher",
        "retrieved_at",
        "citation_locator",
        "research_record_id"
      ],
      "title": "GuideSourceMetadataV1",
      "type": "object"
    },
    "GuideSourceSnapshotV1": {
      "description": "A normal SourceSnapshot with fail-closed guide provenance metadata.",
      "properties": {
        "captured_at": {
          "title": "Captured At",
          "type": "string"
        },
        "content_sha256": {
          "title": "Content Sha256",
          "type": "string"
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excerpt"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "metadata": {
          "$ref": "#/$defs/GuideSourceMetadataV1"
        },
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "status": {
          "default": "active",
          "enum": [
            "active",
            "retracted"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_id",
        "content_sha256",
        "metadata"
      ],
      "title": "GuideSourceSnapshotV1",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Strict handoff from the independent research worker to game storage.",
  "properties": {
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    },
    "guides": {
      "items": {
        "$ref": "#/$defs/GuideKnowledgeV1"
      },
      "minItems": 1,
      "title": "Guides",
      "type": "array"
    },
    "request_id": {
      "minLength": 1,
      "title": "Request Id",
      "type": "string"
    },
    "research_pipeline": {
      "const": "research.run",
      "default": "research.run",
      "title": "Research Pipeline",
      "type": "string"
    },
    "research_record_id": {
      "minLength": 1,
      "title": "Research Record Id",
      "type": "string"
    },
    "schema": {
      "const": "game-observatory.ai-player.guide-research-result.v1",
      "default": "game-observatory.ai-player.guide-research-result.v1",
      "title": "Schema",
      "type": "string"
    },
    "source_snapshots": {
      "items": {
        "$ref": "#/$defs/GuideSourceSnapshotV1"
      },
      "minItems": 1,
      "title": "Source Snapshots",
      "type": "array"
    }
  },
  "required": [
    "request_id",
    "research_record_id",
    "source_snapshots",
    "guides",
    "completed_at"
  ],
  "title": "GuideResearchResultBundleV1",
  "type": "object"
}
