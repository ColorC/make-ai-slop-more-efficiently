{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Viewport-independent UI region in a 1000 by 1000 coordinate space.",
  "properties": {
    "height": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Height",
      "type": "integer"
    },
    "schema": {
      "const": "game-observatory.ai-player.normalized-surface-rect.v1",
      "default": "game-observatory.ai-player.normalized-surface-rect.v1",
      "title": "Schema",
      "type": "string"
    },
    "width": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "title": "Width",
      "type": "integer"
    },
    "x": {
      "maximum": 999,
      "minimum": 0,
      "title": "X",
      "type": "integer"
    },
    "y": {
      "maximum": 999,
      "minimum": 0,
      "title": "Y",
      "type": "integer"
    }
  },
  "required": [
    "x",
    "y",
    "width",
    "height"
  ],
  "title": "NormalizedSurfaceRectV1",
  "type": "object"
}
