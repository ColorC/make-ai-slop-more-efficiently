{
  "$defs": {
    "Tier1RemediationRegressionObservationV1": {
      "additionalProperties": false,
      "description": "One raw fixed-runner observation; aggregate metrics are never caller supplied.",
      "properties": {
        "baseline_decision_latency_ms": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Decision Latency Ms"
        },
        "baseline_model_input_tokens": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Baseline Model Input Tokens"
        },
        "decision_latency_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decision Latency Ms"
        },
        "decision_mode": {
          "default": "planner",
          "enum": [
            "planner",
            "skill_replay",
            "recovery"
          ],
          "title": "Decision Mode",
          "type": "string"
        },
        "evidence_complete": {
          "default": true,
          "title": "Evidence Complete",
          "type": "boolean"
        },
        "expected_change_matched": {
          "title": "Expected Change Matched",
          "type": "boolean"
        },
        "invalid_target_execution": {
          "default": false,
          "title": "Invalid Target Execution",
          "type": "boolean"
        },
        "latency_telemetry_measured": {
          "title": "Latency Telemetry Measured",
          "type": "boolean"
        },
        "model_input_tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Input Tokens"
        },
        "policy_violation": {
          "default": false,
          "title": "Policy Violation",
          "type": "boolean"
        },
        "schema": {
          "const": "game-observatory.ai-player.tier1-remediation-observation.v1",
          "default": "game-observatory.ai-player.tier1-remediation-observation.v1",
          "title": "Schema",
          "type": "string"
        },
        "token_telemetry_measured": {
          "title": "Token Telemetry Measured",
          "type": "boolean"
        }
      },
      "required": [
        "expected_change_matched",
        "token_telemetry_measured",
        "latency_telemetry_measured"
      ],
      "title": "Tier1RemediationRegressionObservationV1",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "failed_assessment_id": {
      "minLength": 1,
      "title": "Failed Assessment Id",
      "type": "string"
    },
    "fixture_id": {
      "minLength": 1,
      "title": "Fixture Id",
      "type": "string"
    },
    "gate_id": {
      "const": "tier1.perception-executor-regression.v1",
      "default": "tier1.perception-executor-regression.v1",
      "title": "Gate Id",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/Tier1RemediationRegressionObservationV1"
      },
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "partition": {
      "enum": [
        "failed_fixture",
        "holdout"
      ],
      "title": "Partition",
      "type": "string"
    },
    "schema": {
      "const": "game-observatory.ai-player.tier1-remediation-fixture.v1",
      "default": "game-observatory.ai-player.tier1-remediation-fixture.v1",
      "title": "Schema",
      "type": "string"
    },
    "source_sample_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Sample Ids",
      "type": "array"
    },
    "suite_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Suite Manifest Sha256",
      "type": "string"
    }
  },
  "required": [
    "fixture_id",
    "environment_id",
    "failed_assessment_id",
    "suite_manifest_sha256",
    "partition",
    "observations"
  ],
  "title": "Tier1RemediationRegressionFixtureV1",
  "type": "object"
}
