          "enum": [
            "tap",
            "swipe",
            "pinch",
            "two_finger_swipe",
            "text",
            "key",
            "launch",
            "force_stop",
            "wait",
            "back",
            "home",
            "mouse_move",
            "mouse_button",
            "gamepad_button",
            "gamepad_axis",
            "reset"
