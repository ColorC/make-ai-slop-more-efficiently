        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text"
        },
        "two_finger_offset_x": {
          "default": 0,
          "maximum": 4096,
          "minimum": -4096,
          "title": "Two Finger Offset X",
          "type": "integer"
        },
        "two_finger_offset_y": {
          "default": 50,
          "maximum": 4096,
          "minimum": -4096,
          "title": "Two Finger Offset Y",
          "type": "integer"
