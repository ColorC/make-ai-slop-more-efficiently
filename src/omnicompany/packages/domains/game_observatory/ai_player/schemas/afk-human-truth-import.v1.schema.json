{
  "$defs": {
    "HumanReviewerV1": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "human_reviewer",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "title": "HumanReviewerV1",
      "type": "object"
    },
    "ImmutableFileRefV1": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "ImmutableFileRefV1",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "attestation": {
      "$ref": "#/$defs/ImmutableFileRefV1"
    },
    "benchmark_id": {
      "const": "afk_hero_growth_v1",
      "default": "afk_hero_growth_v1",
      "title": "Benchmark Id",
      "type": "string"
    },
    "candidate_manifest_id": {
      "const": "afk_hero_growth_v1_candidate_v4",
      "default": "afk_hero_growth_v1_candidate_v4",
      "title": "Candidate Manifest Id",
      "type": "string"
    },
    "candidate_manifest_sha256": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Candidate Manifest Sha256",
      "type": "string"
    },
    "counts_by_collection": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Counts By Collection",
      "type": "object"
    },
    "human_review_status": {
      "const": "signature_verified",
      "title": "Human Review Status",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "import_hash": {
      "maxLength": 64,
      "minLength": 64,
      "title": "Import Hash",
      "type": "string"
    },
    "item_count": {
      "minimum": 1,
      "title": "Item Count",
      "type": "integer"
    },
    "review": {
      "$ref": "#/$defs/ImmutableFileRefV1"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "reviewer": {
      "$ref": "#/$defs/HumanReviewerV1"
    },
    "schema": {
      "const": "game-observatory.ai-player.afk-human-truth-import.v1",
      "default": "game-observatory.ai-player.afk-human-truth-import.v1",
      "title": "Schema",
      "type": "string"
    }
  },
  "required": [
    "id",
    "candidate_manifest_sha256",
    "review",
    "attestation",
    "reviewer",
    "reviewed_at",
    "item_count",
    "counts_by_collection",
    "human_review_status",
    "import_hash"
  ],
  "title": "AFKHumanTruthImportManifestV1",
  "type": "object"
}
