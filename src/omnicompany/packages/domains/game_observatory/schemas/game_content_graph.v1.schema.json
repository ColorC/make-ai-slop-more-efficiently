{
  "$defs": {
    "ApplicabilityScopeV1": {
      "additionalProperties": false,
      "properties": {
        "account_scope_id": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Scope Id"
        },
        "build_scope_id": {
          "minLength": 1,
          "title": "Build Scope Id",
          "type": "string"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "game_id": {
          "minLength": 1,
          "title": "Game Id",
          "type": "string"
        },
        "game_version": {
          "minLength": 1,
          "title": "Game Version",
          "type": "string"
        },
        "locale": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locale"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "valid_from": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid From"
        },
        "valid_through": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Through"
        }
      },
      "required": [
        "environment_id",
        "game_id",
        "build_scope_id",
        "game_version"
      ],
      "title": "ApplicabilityScopeV1",
      "type": "object"
    },
    "ContentConflictV1": {
      "additionalProperties": false,
      "properties": {
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReferenceV1"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Fact Ids",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution"
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fact_ids",
        "status"
      ],
      "title": "ContentConflictV1",
      "type": "object"
    },
    "ContentEntityV1": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "applicability": {
          "$ref": "#/$defs/ApplicabilityScopeV1"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/FactRecordV1"
          },
          "title": "Facts",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "system",
            "state",
            "order",
            "item",
            "generator",
            "resource",
            "currency",
            "task",
            "story",
            "restoration",
            "activity",
            "shop",
            "collection",
            "map",
            "character",
            "reward",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "applicability"
      ],
      "title": "ContentEntityV1",
      "type": "object"
    },
    "ContentRelationV1": {
      "additionalProperties": false,
      "properties": {
        "applicability": {
          "$ref": "#/$defs/ApplicabilityScopeV1"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/FactRecordV1"
          },
          "minItems": 1,
          "title": "Facts",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "relation_type": {
          "minLength": 1,
          "title": "Relation Type",
          "type": "string"
        },
        "source_entity_id": {
          "minLength": 1,
          "title": "Source Entity Id",
          "type": "string"
        },
        "target_entity_id": {
          "minLength": 1,
          "title": "Target Entity Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source_entity_id",
        "relation_type",
        "target_entity_id",
        "applicability",
        "facts"
      ],
      "title": "ContentRelationV1",
      "type": "object"
    },
    "EvidenceReferenceV1": {
      "additionalProperties": false,
      "properties": {
        "artifact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Ids",
          "type": "array"
        },
        "environment_id": {
          "minLength": 1,
          "title": "Environment Id",
          "type": "string"
        },
        "evidence_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Run Ids",
          "type": "array"
        },
        "evidence_step_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Step Ids",
          "type": "array"
        },
        "note": {
          "default": "",
          "maxLength": 2000,
          "title": "Note",
          "type": "string"
        },
        "schema": {
          "const": "game-observatory.ai-player.evidence-reference.v1",
          "default": "game-observatory.ai-player.evidence-reference.v1",
          "title": "Schema",
          "type": "string"
        },
        "source_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Ids",
          "type": "array"
        },
        "trace_run_ids": {
          "items": {
            "type": "string"
          },
          "title": "Trace Run Ids",
          "type": "array"
        }
      },
      "required": [
        "environment_id"
      ],
      "title": "EvidenceReferenceV1",
      "type": "object"
    },
    "FactRecordV1": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "inferred",
                  "unknown"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "rationale": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "rationale"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "contradicted"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "conflict_fact_ids": {
                "minItems": 1
              },
              "evidence_refs": {
                "minItems": 1
              }
            },
            "required": [
              "evidence_refs",
              "conflict_fact_ids"
            ]
          }
        }
      ],
      "properties": {
        "applicability": {
          "$ref": "#/$defs/ApplicabilityScopeV1"
        },
        "conflict_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Conflict Fact Ids",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceReferenceV1"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "rationale": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rationale"
        },
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "statement": {
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified",
            "inferred",
            "unknown",
            "contradicted"
          ],
          "title": "Status",
          "type": "string"
        },
        "supersedes_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supersedes Fact Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "statement",
        "status",
        "applicability",
        "recorded_at"
      ],
      "title": "FactRecordV1",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conflicts": {
      "items": {
        "$ref": "#/$defs/ContentConflictV1"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/ContentEntityV1"
      },
      "minItems": 1,
      "title": "Entities",
      "type": "array"
    },
    "environment_id": {
      "minLength": 1,
      "title": "Environment Id",
      "type": "string"
    },
    "game_id": {
      "minLength": 1,
      "title": "Game Id",
      "type": "string"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "relations": {
      "items": {
        "$ref": "#/$defs/ContentRelationV1"
      },
      "title": "Relations",
      "type": "array"
    },
    "schema": {
      "const": "game-observatory.game-content-graph.v1",
      "default": "game-observatory.game-content-graph.v1",
      "title": "Schema",
      "type": "string"
    },
    "source_dossier_ids": {
      "items": {
        "type": "string"
      },
      "title": "Source Dossier Ids",
      "type": "array"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "game_id",
    "environment_id",
    "entities",
    "updated_at"
  ],
  "title": "GameContentGraphV1",
  "type": "object"
}
