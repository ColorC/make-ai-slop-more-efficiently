        },
        "wall_clock_boundary": {
          "minLength": 1,
          "title": "Wall Clock Boundary",
          "type": "string"
        }
      },
      "required": [
        "candidate_id",
        "route_id",
        "game_id",
        "environment_id",
        "chain_kind",
        "execution_status",
        "execution_authorization",
        "executable",
        "activation_requirements",
        "source_state_guard",
        "locators",
        "batch_end_checkpoint",
        "terminal_receipt_requirements",
        "wall_clock_boundary",
        "success_branch",
        "failure_branch",
        "recovery_branch",
        "forbidden_actions",
