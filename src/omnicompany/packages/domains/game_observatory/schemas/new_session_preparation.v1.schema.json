            "required": [
              "execution_status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "blocking_reasons": {
                    "maxItems": 0
                  },
                  "executable": {
                    "const": true
                  },
                  "execution_authorization": {
                    "const": "benchmark"
