{
    "Omni@NoOp": {
        "doc": "阳性对照：必然成功且立即返回。用于判定 Custom/task_names 通道本身是否可用，把「通道坏了」与「屏上没有目标」区分开。",
        "algorithm": "JustReturn",
        "action": "DoNothing",
        "maxTimes": 1
    },

