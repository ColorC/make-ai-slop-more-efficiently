{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "model": "lilith/gpt-5.6-terra",
  "default_agent": "omni-worker",
  "subagent_depth": 0,
  "autoupdate": false,
  "enabled_providers": ["lilith"],
  "provider": {
    "lilith": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Lilith OpenAI-compatible proxy",
      "options": {
        "baseURL": "https://llm-proxy.lilithgames.com/v1",
        "apiKey": "{env:LILITH_API_KEY}"
      },
      "models": {
        "qwen3.7-max": {
          "name": "Qwen 3.7 Max",
          "limit": {"context": 200000, "output": 32000}
        },
        "claude-sonnet-4-6": {
          "name": "Claude Sonnet 4.6",
          "limit": {"context": 200000, "output": 32000}
        },
        "gpt-5.5": {
          "name": "GPT 5.5",
          "limit": {"context": 200000, "output": 32000}
        },
        "gpt-5.6-terra": {
          "name": "GPT 5.6 Terra"
        }
      }
    }
  },
  "permission": {
    "*": "allow",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "task": "deny",
    "bash": {
      "*": "allow",
      "find": "deny",
      "find *": "deny",
      "find.exe *": "deny",
      "head": "deny",
      "head *": "deny",
      "head.exe *": "deny",
      "rg": "deny",
      "rg *": "deny",
      "rg.exe *": "deny",
      "mkdir": "deny",
      "mkdir *": "deny",
      "md": "deny",
      "md *": "deny",
      "New-Item *": "deny",
      "Set-Content *": "deny",
      "Add-Content *": "deny",
      "Out-File *": "deny",
      "tee *": "deny",
      "sed -i *": "deny",
      "powershell *": "deny",
      "powershell.exe *": "deny",
      "pwsh *": "deny",
      "bash *": "deny",
      "sh *": "deny",
      "zsh *": "deny",
      "wsl *": "deny",
      "cmd *": "deny",
      "cmd.exe *": "deny",
      "git push *": "deny",
      "git commit *": "deny",
      "rm *": "deny",
      "rmdir *": "deny",
      "Remove-Item *": "deny"
    },
    "doom_loop": "deny"
  },
  "agent": {
    "omni-worker": {
      "description": "Writes real files, uses native tools, verifies work in place, and never starts nested agents.",
      "mode": "primary",
      "model": "lilith/gpt-5.6-terra",
      "prompt": "Work only in the declared workspace and task context. Read supplied decisions and evidence before acting. On Windows, treat the shell as PowerShell unless a tool explicitly declares Bash. Never use head or find; use native Read, Glob, and Grep tools. Never create directories or write text through shell commands, redirection, tee, sed -i, New-Item, Set-Content, Add-Content, or Out-File; use guarded file tools with exact existing parent paths. Never invoke a second shell from the first. Require an explicit cwd and exact write paths. Keep UTF-8 without BOM, then reread written text and reject replacement characters or mojibake. Write real files, run deterministic checks, read failures, and repair the same files in this session. Never invent facts, silently change models, restart from scratch, spawn subagents, browse the web, or expose secrets. Stop and report when evidence is ambiguous or an error could have serious consequences.",
      "permission": {
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny"
      }
    }
  }
}
