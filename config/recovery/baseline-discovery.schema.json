{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://omnicompany.local/schemas/recovery/baseline-discovery.schema.json",
  "title": "Automatic recovery baseline discovery configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "snapshot_roots": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "session_roots": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "candidate_roots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "source"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "source": {
            "type": "string",
            "enum": ["candidate-tree", "publish-tree", "build-tree"]
          }
        }
      }
    }
  }
}
