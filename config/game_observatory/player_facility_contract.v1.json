  "continuous_session_policy": {
    "allowed_restart_reasons": [
      "phase_complete",
      "provider_failover",
      "hard_reset",
      "environment_identity_change",
      "facility_contract_change",
      "unrecoverable_context_pollution",
      "benchmark_isolation"
    ],
    "checkpoint_every_semantic_actions": 10,
    "forbidden_behaviors": [
      "每个游戏动作创建一个新 Agent 或新 Session",
      "把单步证据边界误作 Agent 生命周期边界",
      "无心跳地长时间占用设备",
      "重复读取完整设施说明代替恢复焦点上下文"
    ],
    "full_help_load_events": [
      "session_start",
      "facility_contract_change"
    ],
    "heartbeat_after_device_action": true,
    "heartbeat_interval_seconds_max": 30,
    "safe_stop_after_silence_seconds": 60,
    "semantic_actions_per_session_min": 10,
    "semantic_actions_per_session_target": 30,
    "warn_after_silence_seconds": 30
  },
  "external_agent_providers": [
    {
      "effort_argument": "-c model_reasoning_effort=\"{effort}\"",
      "event_format": "jsonl",
      "executable": "codex",
      "provider": "codex-cli",
      "resume_template": [
        "codex",
        "exec",
        "resume",
        "-m",
        "{model}",
        "-c",
        "model_reasoning_effort=\"{effort}\"",
        "--json",
        "{session_id}",
        "{prompt}"
      ],
      "session_id_source": "thread.started.thread_id",
      "start_template": [
        "codex",
        "exec",
        "-C",
        "{workspace}",
        "-m",
        "{model}",
        "-c",
        "model_reasoning_effort=\"{effort}\"",
        "--json",
        "{prompt}"
      ]
    },
    {
      "effort_argument": "--effort {effort}",
      "event_format": "stream-json",
      "executable": "claude",
      "provider": "claude-code-cli",
      "resume_template": [
        "claude",
        "-p",
        "--model",
        "{model}",
        "--effort",
        "{effort}",
        "--output-format",
        "stream-json",
        "--resume",
        "{session_id}",
        "{prompt}"
      ],
      "session_id_source": "caller-assigned --session-id / result.session_id",
      "start_template": [
        "claude",
        "-p",
        "--model",
        "{model}",
        "--effort",
        "{effort}",
        "--output-format",
        "stream-json",
        "--session-id",
