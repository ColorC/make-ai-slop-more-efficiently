scripts/job_apply/self_eval.md
scripts/job_apply/*.local.*

# ⛔ 运行时/临时/数据产物 — 永不入 git(2026-08-17 事故: 一笔 checkpoint 提交把 28GB 数据扫进
# main 历史, 自动备份每 30min 重打包 12GB 内存拖垮整机。git 只存代码与文档, 数据走对象备份队列)
/tmp/
/.tmp/
/.codex-tmp/
/.reviewstage-staging/
/exports/
/sandbox/
/artifacts/
/output/
/.local/
/.pytest-tmp/
/_remake_tmp/
/.playwright-cli/
/hypothesis/
/var/runtime/arknights/remote-sync-*/
/var/runtime/arknights/lightweight-tournament/recordings/
/var/vendor/_download/

# ── voxelcraft 数据区白名单 (阶段一 1-6, 2026-07-06) ──
# curated references (~1.3MB 人工整理/抓取, 不可再生) + MANIFEST 进 git;
# twilightforest/source (124MB 上游克隆) / 贴图池 / 缓存仍走重建 (见 data/domains/voxelcraft/MANIFEST.yaml)
!data/
data/*
# task-core 个人附加层词表 —— 是口径不是运行时台账, 必须入库
# (人读面: docs/plans/_cross/[2026-09-01]TASK-CORE-PERSONAL-TASK-BUS/personal-task-profile.md)
!data/task_core_profile.json
!data/domains/
data/domains/*
!data/domains/voxelcraft/
data/domains/voxelcraft/*
!data/domains/voxelcraft/MANIFEST.yaml
!data/domains/voxelcraft/references/
data/domains/voxelcraft/references/twilightforest/source/
# north-stars 权威源 (2026-07-26 从 docs/north-stars/ 迁入, OMNI-035h):
# 人工策展不可再生, 比照 voxelcraft 白名单进 git
!data/domains/personal_site/
data/domains/personal_site/*
!data/domains/personal_site/north-stars.json

